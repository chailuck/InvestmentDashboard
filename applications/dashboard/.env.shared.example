# Shared secrets loaded by BOTH applications/dashboard/backend and
# applications/dashboard/tracking-backend (see docker-compose.yml `env_file`
# lists for each service). Copy this file to `.env.shared` (untracked — real
# secrets never get committed) and fill in real values.
#
# Why this file exists: tracking-backend verifies JWTs issued by backend, so
# both services MUST sign/verify with the exact same APP_SECRET_KEY. Keeping
# it in one shared file — rather than duplicating it into backend/.env and
# tracking-backend/.env separately — prevents the two values from silently
# drifting apart after a key rotation.
#
# Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

APP_SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">
