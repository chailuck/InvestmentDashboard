# Application
APP_NAME="Financial Tracker API"
APP_ENV=development
# APP_SECRET_KEY MUST be byte-for-byte identical to the main backend's
# APP_SECRET_KEY (applications/dashboard/backend/.env) — this service verifies
# JWTs signed by that service and never issues its own. Prefer loading both
# from the shared applications/dashboard/.env.shared file instead of setting
# it separately here, to prevent the two values from drifting apart.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-me-to-the-SAME-value-as-backend/.env-APP_SECRET_KEY
LOG_LEVEL=INFO
API_PREFIX=/api/v1/tracking

# Database — same Postgres instance/database as the main backend, but this
# service only ever reads/writes its own `ft_*` tables.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investment_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis — shared with the main backend, used only for the JWT blacklist check.
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000"]
