# Shared secrets loaded by BOTH applications/dashboard/backend and
# applications/dashboard/tracking-backend. Untracked (see .gitignore) — real
# secrets never get committed. Value below matches backend/.env's existing
# APP_SECRET_KEY exactly, so tracking-backend can verify JWTs signed by backend
# without invalidating any existing sessions.
APP_SECRET_KEY=change-me-to-a-long-random-string-in-production
