# Docker Compose environment variables
# Copy this file to .env and fill in real values before running docker compose up

# Host paths for investment data mounts (set to your local paths)
# Windows example: D:/Documents/Pop/AI Agents/InvestmentAgent01/investmentPlan
INVESTMENT_DATA_PATH=./data/investmentPlan
INVESTMENT_AGENT_PATH=./data/investmentAgent

# Read-write mount for the personal knowledge vault. The "Generate Overall
# Plan" feature (weekly-scan detail page) writes generated reports to
# <this path>/Weeklyplan/OVERALL PLAN <YYYYMMDD>.md inside the backend
# container. Set this to your local vault "raw" folder.
# Windows example: D:/Documents/Pop/Knowledge/Vault-Investment/Investment/raw
VAULT_INVESTMENT_RAW_PATH=./data/vaultInvestmentRaw
